# Local DeepSeek-V4-Flash-0731 deployment defaults.
# Every setting can be overridden by exporting it before invoking a script.

: "${ROOT:=$(CDPATH= cd -- "$(dirname "$0")" && pwd)}"

if [ -f "$ROOT/config.local.env" ]; then
    . "$ROOT/config.local.env"
fi

: "${DS4_DIR:=$HOME/ds4}"
: "${DS4_SERVER:=$DS4_DIR/ds4-server}"
: "${DS4_CLI:=$DS4_DIR/ds4}"
: "${MODEL_PATH:=$HOME/models/deepseek-v4-flash-0731/DeepSeek-V4-Flash-IQ2XXS-imatrix-0731.gguf}"
: "${MODEL_SIZE:=86720111488}"
: "${MODEL_SHA256:=ca22ae2f838e14077c22bc1c1417b71b45b5e5a3687bd96c2ac6e17fdb6261c0}"

: "${SERVER_HOST:=127.0.0.1}"
: "${SERVER_PORT:=8000}"
: "${SERVER_CTX:=16384}"
: "${SERVER_TOKENS:=512}"
: "${PREFILL_CHUNK:=1024}"
: "${EXPERT_CACHE:=12GB}"
: "${SERVER_START_TIMEOUT:=1800}"
: "${LAUNCH_MODE:=launchd}"
: "${LAUNCH_LABEL:=ai.deepseek-v4-local}"
: "${PLIST_PATH:=$HOME/Library/LaunchAgents/$LAUNCH_LABEL.plist}"
: "${DASHBOARD_HOST:=127.0.0.1}"
: "${DASHBOARD_PORT:=8791}"
: "${DASHBOARD_LABEL:=ai.deepseek-v4-local.dashboard}"
: "${DASHBOARD_PLIST_PATH:=$HOME/Library/LaunchAgents/$DASHBOARD_LABEL.plist}"

: "${STATE_DIR:=$ROOT/run}"
: "${PID_FILE:=$STATE_DIR/ds4-server.pid}"
: "${LOG_FILE:=$STATE_DIR/ds4-server.log}"
: "${VERIFIED_STAMP:=$STATE_DIR/model.verified}"
